<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".feature.main.MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/main_fcv"
        android:name="com.example.a36_study_android_xml.feature.home.HomeFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/main_bottom_navi" />
        />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/main_bottom_navi"
        app:menu="@menu/main_bottom_navi_menu"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="@color/black"
        app:itemIconSize="40dp"
        app:labelVisibilityMode="labeled"
        app:itemActiveIndicatorStyle="@null"
        app:itemPaddingTop="5dp"
        app:itemPaddingBottom="0dp"
        app:itemIconTint="@color/main_navi_color_selector"
        app:itemTextColor="@color/main_navi_color_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
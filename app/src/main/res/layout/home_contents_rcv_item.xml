<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_contents_rcv_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/home_contents_rcv_item_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="80sp"
        android:textStyle="italic"
        android:translationY="19dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/home_contents_rcv_item_iv"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/home_contents_rcv_item_iv"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/home_contents_round_img_bg"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/img_home_contents_banner1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/home_contents_rcv_item_tv"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
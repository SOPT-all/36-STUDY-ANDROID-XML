<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".feature.signin.SignInFragment">

    <ImageView
        android:id="@+id/signin_back_btn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_signin_back_24" />

    <TextView
        android:id="@+id/signin_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TVING ID 로그인"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginTop="50dp"
        android:textSize="24sp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/signin_back_btn"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/sigin_id_edittext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="아이디"
        android:background="@drawable/base_edittext_background"
        android:maxLines="1"
        android:inputType="text"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:textColorHint="@color/gray700"
        android:paddingHorizontal="20dp"
        android:paddingVertical="15dp"
        android:layout_marginTop="25dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/signin_title_tv"/>

    <EditText
        android:id="@+id/sigin_pw_edittext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="비밀번호"
        android:background="@drawable/base_edittext_background"
        android:drawableEnd="@drawable/ic_signin_visibility_off_24"
        android:maxLines="1"
        android:inputType="textPassword"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:textColorHint="@color/gray700"
        android:paddingHorizontal="20dp"
        android:paddingVertical="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/sigin_id_edittext"/>

    <Button
        android:id="@+id/sigin_login_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/gray800"
        app:cornerRadius="4dp"
        android:text="로그인하기"
        android:textStyle="bold"
        android:textColor="@color/gray500"
        android:textSize="16sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:padding="0dp"
        android:minHeight="50dp"
        android:minWidth="0dp"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/sigin_pw_edittext"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/sigin_login_btn"
        android:layout_marginTop="50dp"
        android:gravity="center"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아이디 찾기"
            android:textSize="14sp"
            android:textColor="@color/gray500"/>
        <View
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:paddingVertical="50dp"
            android:backgroundTint="@color/gray500"
            android:layout_marginHorizontal="8dp"
            android:background="@color/gray500" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="비밀번호 찾기"
            android:textSize="14sp"
            android:textColor="@color/gray500"/>
        <View
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:paddingVertical="50dp"
            android:backgroundTint="@color/gray500"
            android:layout_marginHorizontal="8dp"
            android:background="@color/gray500" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="회원가입"
            android:textSize="14sp"
            android:textColor="@color/gray500"/>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/signInFragment">

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.purang.xmlstudy.presentation.signin.SignInFragment"
        android:label="Sign In"
        tools:layout="@layout/fragment_sign_in" >
        <action
            android:id="@+id/action_signInFragment_to_homeFragment"
            app:destination="@id/fragment_home"
            app:popUpTo="@id/signInFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/fragment_home"
        android:name="com.purang.xmlstudy.presentation.home.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/fragment_shorts"
        android:name="com.purang.xmlstudy.presentation.shorts.ShortsFragment"
        android:label="Shorts" />

    <fragment
        android:id="@+id/fragment_live"
        android:name="com.purang.xmlstudy.presentation.live.LiveFragment"
        android:label="Live" />

    <fragment
        android:id="@+id/fragment_search"
        android:name="com.purang.xmlstudy.presentation.search.SearchFragment"
        android:label="Search" />

    <fragment
        android:id="@+id/fragment_history"
        android:name="com.purang.xmlstudy.presentation.history.HistoryFragment"
        android:label="History" />

    <fragment
        android:id="@+id/fragment_profile"
        android:name="com.purang.xmlstudy.presentation.profile.ProfileFragment"
        android:label="Profile" />
</navigation>
